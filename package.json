{
  "name": "shard-icons",
  "version": "1.1.0",
  "description": "Folder and file icons for the Obsidian file explorer, in the Material Icon Theme style.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachewraith/shard-icons.git"
  },
  "bugs": {
    "url": "https://github.com/cachewraith/shard-icons/issues"
  },
  "homepage": "https://github.com/cachewraith/shard-icons#readme",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "icons",
    "file-explorer"
  ],
  "scripts": {
    "icons": "node scripts/build-icons.ts",
    "dev": "npm run icons && node esbuild.config.mjs",
    "build": "npm run icons && tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "npm run icons && tsc --noEmit",
    "test": "npm run icons && vitest run",
    "test:watch": "npm run icons && vitest",
    "lint": "npm run icons && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mdi/svg": "7.4.47",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-obsidianmd": "0.5.1",
    "jsdom": "31.0.0",
    "material-icon-theme": "5.38.1",
    "obsidian": "1.14.4",
    "prettier": "3.9.10",
    "simple-icons": "16.31.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
